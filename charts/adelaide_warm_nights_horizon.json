{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Genuine folded horizon chart: 0.5 °C signed anomaly bands overlaid on a shared baseline. Each annual segment has two x endpoints and is grouped by year, preserving gaps for excluded incomplete years. Colour identifies band offset and sign; height is the remainder. Sum of signed band heights reconstructs each anomaly.",
  "title": {
    "text": "Are Adelaide’s nights getting warmer?",
    "subtitle": "Annual minimum-temperature anomalies relative to the 1910–1939 baseline",
    "fontSize": {
      "expr": "width < 500 ? 13 : 18"
    },
    "subtitleFontSize": {
      "expr": "width < 500 ? 9 : 12"
    },
    "anchor": "start",
    "offset": 18
  },
  "data": {
    "url": "data/bom_adelaide_tmin_anomaly.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "annual_mean_tmin": "number",
        "baseline_tmin": "number",
        "anomaly": "number",
        "observation_count": "number"
      }
    }
  },
  "width": "container",
  "height": 240,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Year",
      "scale": {
        "domain": [
          1909.5,
          2024.5
        ],
        "nice": false
      },
      "axis": {
        "values": [
          1910,
          1930,
          1950,
          1970,
          1990,
          2010,
          2024
        ],
        "format": "d",
        "labelOverlap": true,
        "grid": false
      }
    },
    "y": {
      "field": "band_height",
      "type": "quantitative",
      "title": null,
      "scale": {
        "domain": [
          0,
          0.5
        ],
        "nice": false
      },
      "axis": {
        "values": [
          0,
          0.5
        ],
        "labelExpr": "datum.value === 0 ? 'Baseline' : '0.5 °C fold'",
        "grid": false,
        "domain": false,
        "ticks": false,
        "labelPadding": 8
      }
    }
  },
  "layer": [
    {
      "transform": [
        {
          "calculate": "clamp(1 * datum.anomaly - 0 * 0.5, 0, 0.5)",
          "as": "band_height"
        },
        {
          "calculate": "\"0 to +0.5\"",
          "as": "band_label"
        },
        {
          "calculate": "[datum.year - 0.5, datum.year + 0.5]",
          "as": "year_edges"
        },
        {
          "flatten": [
            "year_edges"
          ],
          "as": [
            "year_position"
          ]
        }
      ],
      "mark": {
        "type": "area",
        "orient": "vertical",
        "interpolate": "linear",
        "clip": true
      },
      "encoding": {
        "x": {
          "field": "year_position",
          "type": "quantitative"
        },
        "y": {
          "field": "band_height",
          "type": "quantitative"
        },
        "y2": {
          "datum": 0
        },
        "detail": {
          "field": "year",
          "type": "nominal"
        },
        "color": {
          "field": "band_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "0 to +0.5",
              "+0.5 to +1.0",
              "+1.0 to +1.5",
              "+1.5 to +2.0",
              "0 to −0.5",
              "−0.5 to −1.0",
              "−1.0 to −1.5",
              "−1.5 to −2.0"
            ],
            "range": [
              "#edd4c8",
              "#d7a086",
              "#b96c4a",
              "#8d3a23",
              "#d4e2eb",
              "#9bbbd1",
              "#628da9",
              "#315f7b"
            ]
          },
          "legend": {
            "title": "Temperature anomaly bands (°C)",
            "orient": "bottom",
            "columns": 4,
            "labelFontSize": 10,
            "symbolType": "square",
            "symbolSize": 110,
            "labelLimit": 120,
            "rowPadding": 6
          }
        }
      }
    },
