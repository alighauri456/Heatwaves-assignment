{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "TEST: mean of available land cells within each 2x2 block of the original 0.11-degree grid, 2020–2025. Full 0.22-degree block footprints share edges; there is no interpolation. Coastal blocks may contain only 1–3 land cells and their rectangles extend over the rest of the block. min/max latitude and longitude describe source cell centres, not rectangle edges.",
  "title": {
    "text": "Heatwave frequency across Australia",
    "subtitle": [
      "Average heatwave days per year across Australia",
      "2020s: 2020–2025 only · Source: CSIRO"
    ],
    "anchor": "start",
    "offset": 16
  },
  "data": {
    "url": "data/csiro_2020s_grid_2x2.csv",
    "format": {
      "type": "csv",
      "parse": {
        "decade": "string",
        "mean_heatwave_days": "number",
        "min_latitude": "number",
        "max_latitude": "number",
        "min_longitude": "number",
        "max_longitude": "number",
        "south": "number",
        "north": "number",
        "west": "number",
        "east": "number",
        "source_cell_count": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "{'type': 'Feature', 'geometry': {'type': 'Polygon', 'coordinates': [[[datum.west, datum.south], [datum.west, datum.north], [datum.east, datum.north], [datum.east, datum.south], [datum.west, datum.south]]]}}",
      "as": "grid_cell"
    }
  ],
  "width": "container",
  "height": 500,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -134,
      0,
      0
    ],
    "center": [
      0,
      -27
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "mark": {
    "type": "geoshape",
    "strokeWidth": 0.5,
    "stroke": {
      "expr": "scale('color', datum.mean_heatwave_days)"
    }
  },
  "encoding": {
    "shape": {
      "field": "grid_cell",
      "type": "geojson"
    },
    "color": {
      "field": "mean_heatwave_days",
      "type": "quantitative",
      "scale": {
        "scheme": "yelloworangered",
        "zero": true,
        "domain": [
          0,
          46.833333333333336
        ]
      },
      "legend": {
        "title": "Average heatwave days per year",
        "titleLimit": 300,
        "orient": "bottom",
        "direction": "horizontal",
        "gradientLength": 220,
        "gradientThickness": 12,
        "format": ".0f",
        "tickCount": 5,
        "type": "gradient"
      }
    },
    "tooltip": [
      {
        "field": "decade",
        "type": "nominal",
        "title": "Decade"
      },
      {
        "field": "mean_heatwave_days",
        "type": "quantitative",
        "title": "Block average heatwave days per year",
        "format": ".1f"
      },
      {
        "field": "source_cell_count",
        "type": "quantitative",
        "title": "Land cells averaged",
        "format": "d"
      },
      {
        "field": "south",
        "type": "quantitative",
        "title": "South edge (°)",
        "format": ".3f"
      },
      {
        "field": "north",
        "type": "quantitative",
        "title": "North edge (°)",
        "format": ".3f"
      },
      {
        "field": "west",
        "type": "quantitative",
        "title": "West edge (°)",
        "format": ".3f"
      },
      {
        "field": "east",
        "type": "quantitative",
        "title": "East edge (°)",
        "format": ".3f"
      }
    ]
  },
  "config": {
    "background": "transparent",
    "font": "Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "title": {
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#263238",
      "subtitleFontSize": 12,
      "subtitleColor": "#4B5563",
      "subtitlePadding": 8,
      "subtitleLineHeight": 18
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "labelColor": "#4B5563",
      "titleColor": "#374151",
      "padding": 8
    }
  },
  "usermeta": {
    "embedOptions": {
      "renderer": "canvas",
      "actions": false
    }
  }
}
